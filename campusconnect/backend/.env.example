PORT=4000
# Comma-separated origins allowed to call this API (dev default allows the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Secret used to sign session tokens (HMAC-SHA256). Change this in production.
AUTH_SECRET=dev-secret-change-me
# Base URL of the Python AI microservice (ai-service/). Falls back to a local stub if unset/unreachable.
AI_SERVICE_URL=http://localhost:8000
